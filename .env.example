# Copie ce fichier en .env et adapte les valeurs si besoin avant un déploiement
# standalone (docker compose -f docker-compose.prod.yml up).
#
# En déploiement Coolify, les variables sont posées via l'UI de chaque app, et ce
# fichier n'est PAS utilisé (cf. docs/user/how-to/deploy-coolify.md).

# Tag d'image — laisse "latest" sauf si tu gères plusieurs versions
IMAGE_TAG=latest

# Hosts publics (les valeurs par défaut dans docker-compose.prod.yml suffisent
# pour skillbridge-data.fr — surcharge ici uniquement en cas d'autre domaine)
FRONT_HOST=app.skillbridge-data.fr
API_HOST=api.skillbridge-data.fr
DOCS_HOST=docs.skillbridge-data.fr
