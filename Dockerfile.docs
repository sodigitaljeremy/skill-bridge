# Dockerfile.docs — Doc statique servie par nginx
#
# Multi-stage : mkdocs build dans un container Python, puis nginx:alpine sert site/.
# Image résultante : ~50 MB (nginx + 26 pages HTML + assets Material).
#
# Build :     docker build -f Dockerfile.docs -t skillbridge-docs .
# Run local : docker run --rm -p 8080:80 skillbridge-docs

ARG PYTHON_VERSION=3.12-slim-bookworm

# ─────────────────────────────────────────────────────────────────────────────
# Stage 1 — Builder : mkdocs build avec le thème Material
# ─────────────────────────────────────────────────────────────────────────────
FROM python:${PYTHON_VERSION} AS builder

ENV PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN pip install --no-cache-dir \
        "mkdocs>=1.6" \
        "mkdocs-material>=9.7" \
        "pymdown-extensions>=10.21"

WORKDIR /docs

COPY mkdocs.yml ./
COPY docs/ ./docs/

# Build strict : échoue si lien cassé ou nav incohérente.
RUN mkdocs build --strict --site-dir /site

# ─────────────────────────────────────────────────────────────────────────────
# Stage 2 — Runtime : nginx Alpine sert /site
# ─────────────────────────────────────────────────────────────────────────────
FROM nginx:1.27-alpine AS runtime

# Conf minimale : gzip, cache assets, fallback /index.html sur 404 (utile pour
# Material qui a des routes "permalink" sans extension).
COPY <<EOF /etc/nginx/conf.d/default.conf
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Compression
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/javascript application/javascript application/json image/svg+xml;

    # Cache long pour assets versionnés Material (CSS/JS bundle.<hash>.min.*)
    location ~* \.(css|js|woff2?|ttf|eot|svg|png|jpg|gif|ico)\$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # Pages HTML : pas de cache (re-déploiement)
    location / {
        try_files \$uri \$uri/ \$uri/index.html =404;
        add_header Cache-Control "no-cache";
    }

    # Healthcheck simple
    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }
}
EOF

COPY --from=builder /site /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=10s --timeout=3s --retries=3 \
    CMD wget -q -O - http://127.0.0.1/healthz | grep -q ok || exit 1
